---
import Footer from "../components/ui/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Premium Auto Upholstery and Interior Restoration",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Oswald:wght@200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="bg-light-bg text-light-text min-h-screen flex flex-col font-sans tracking-[0.02em]"
  >
    <header
      class="py-4 px-4 border-b border-light-accent sticky top-0 bg-light-accent text-white z-50 shadow-md relative"
    >
      <div class="max-w-6xl mx-auto flex justify-between items-center relative z-20">
        <a href="/" class="text-2xl font-bold tracking-tighter text-white">
          Cypress <span class="opacity-80">Leather Interiors</span>
        </a>
        
        <!-- Desktop Nav -->
        <nav class="hidden md:block">
          <ul class="flex gap-6 text-sm font-medium text-white/80">
            <li><a href="#about" class="hover:text-white transition-colors">About</a></li>
            <li><a href="#services" class="hover:text-white transition-colors">Services</a></li>
            <li><a href="#gallery" class="hover:text-white transition-colors">Gallery</a></li>
            <li><a href="#reviews" class="hover:text-white transition-colors">Reviews</a></li>
            <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
          </ul>
        </nav>

        <!-- Mobile Toggle Button -->
        <button id="mobile-menu-toggle" class="md:hidden p-2 text-white hover:text-white/80 transition-colors" aria-label="Toggle Menu">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>

      <!-- Mobile Nav Overlay -->
      <nav id="mobile-menu" class="fixed inset-0 bg-light-accent/95 backdrop-blur-sm z-10 flex-col items-center justify-center hidden">
        <ul class="flex flex-col gap-8 text-2xl font-bold text-white/90 text-center">
          <li><a href="#about" class="mobile-link hover:text-white transition-colors">About</a></li>
          <li><a href="#services" class="mobile-link hover:text-white transition-colors">Services</a></li>
          <li><a href="#gallery" class="mobile-link hover:text-white transition-colors">Gallery</a></li>
          <li><a href="#reviews" class="mobile-link hover:text-white transition-colors">Reviews</a></li>
          <li><a href="#faq" class="mobile-link hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </nav>
    </header>
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Oswald", sans-serif;
    font-weight: 300;
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        document.body.style.overflow = '';
      }
    });
    
    // Close menu when a link is clicked
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        document.body.style.overflow = '';
      });
    });
  }
</script>
