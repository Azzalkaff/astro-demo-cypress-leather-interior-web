---
const reviews = [
  { id: 1, name: 'John D.', role: 'Local Customer', text: 'They did a fantastic job redoing the interior of my classic car. The level of workmanship and detail are unmatched. Highly recommend!', rating: 5 },
  { id: 2, name: 'Sarah M.', role: 'Verified Review', text: 'This is a great shop. They offer real craftsmanship at reasonable prices and finished the project right on schedule.', rating: 5 },
  { id: 3, name: 'Michael T.', role: 'Car Enthusiast', text: 'I needed the upholstery in my vintage truck redone and this team blew me away with how good it looks. They pay attention to detail and make sure you get exactly what you ask for.', rating: 5 },
];
---

<section id="reviews" class="py-24 px-4 bg-light-card">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div>
        <h2 class="text-3xl md:text-5xl font-bold text-light-text mb-4">Customer Reviews</h2>
        <p class="text-light-muted">See what our satisfied clients have to say.</p>
      </div>
      <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full border border-gray-200 shadow-sm">
        <span class="text-light-accent">★★★★★</span>
        <span class="text-light-text font-medium">5.0 Average</span>
      </div>
    </div>

    <style>
      .hide-scroll::-webkit-scrollbar { display: none; }
      .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    
    <div id="testimonial-scroll" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-4 hide-scroll">
      {reviews.map((review) => (
        <div class="w-full max-w-4xl mx-auto flex-shrink-0 snap-center bg-white p-8 md:p-12 border border-gray-200 relative shadow-sm">
          <div class="text-6xl text-light-accent opacity-10 absolute top-8 right-12 font-serif">"</div>
          <div class="flex justify-center text-light-accent mb-8 text-lg">
            {Array.from({ length: review.rating }).map(() => (
               <span>★</span>
            ))}
          </div>
          <p class="text-light-text mb-10 text-xl md:text-2xl leading-relaxed italic text-center">"{review.text}"</p>
          <div class="flex flex-col items-center gap-3">
            <div class="w-16 h-16 bg-light-bg rounded-full flex items-center justify-center font-bold text-light-accent border border-gray-200 text-xl">
              {review.name.charAt(0)}
            </div>
            <div class="text-center">
              <h4 class="text-light-text font-bold text-lg">{review.name}</h4>
              <span class="text-light-muted text-sm">{review.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="flex justify-center mt-6">
      <div class="flex gap-2" id="testimonial-indicators">
        {reviews.map((_, index) => (
          <div class={`w-3 h-3 rounded-full ${index === 0 ? 'bg-light-accent' : 'bg-gray-300'}`}></div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('testimonial-scroll');
    const indicators = document.getElementById('testimonial-indicators')?.children;
    if (!scrollContainer) return;
    
    let currentIndex = 0;
    const totalItems = scrollContainer.children.length;

    setInterval(() => {
      currentIndex = (currentIndex + 1) % totalItems;
      const scrollStep = scrollContainer.clientWidth;
      
      scrollContainer.scrollTo({
        left: currentIndex * scrollStep,
        behavior: 'smooth'
      });
      
      // Update indicators if they exist
      if (indicators) {
        Array.from(indicators).forEach((ind, idx) => {
          if (idx === currentIndex) {
            ind.className = 'w-3 h-3 rounded-full bg-light-accent transition-colors duration-300';
          } else {
            ind.className = 'w-3 h-3 rounded-full bg-gray-300 transition-colors duration-300';
          }
        });
      }
    }, 5000);
  });
</script>
