---
---
<section id="about" class="py-24 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Image Column -->
      <div class="relative w-full aspect-square md:aspect-[4/5] bg-gray-100 shadow-md">
        <img 
          src="/images/about_us_new.png" 
          alt="Expert craftsman stitching leather" 
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute -bottom-6 -right-6 bg-light-accent text-white p-6 shadow-lg hidden md:block">
          <span class="block text-4xl font-bold mb-1">20+</span>
          <span class="block text-sm uppercase tracking-wider font-semibold">Years of<br/>Experience</span>
        </div>
      </div>
      
      <!-- Text Column -->
      <div>
        <span class="text-light-accent font-semibold tracking-wider uppercase text-sm mb-4 block">About Us</span>
        <h2 class="text-3xl md:text-5xl font-bold text-light-text mb-6 leading-tight">
          Over 20 Years of Perfecting Auto Interiors
        </h2>
        <p class="text-light-muted text-lg leading-relaxed mb-10">
          At Cypress Leather Interiors, we deliver top-tier craftsmanship for every vehicle. From classic restorations to simple seat repairs, our skilled artisans use only the highest quality materials to ensure a perfect fit and finish.
        </p>
        

        
        <div>
          <a href="#contact" class="inline-flex items-center text-light-accent font-semibold hover:brightness-75 active:scale-95 transition-all text-lg">
            Talk to Our Craftsmen
            <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>
      
    </div>
  </div>
</section>
