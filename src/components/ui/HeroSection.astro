---
---
<section class="flex flex-col">
  <!-- Image block: Full width, without opacity -->
  <div class="w-full h-[60vh] md:h-[85vh]">
    <img src="/images/hero_bg_new.png" alt="Auto Upholstery" class="w-full h-full object-cover" />
  </div>
  
  <!-- Content block: Moved below the image -->
  <div class="bg-light-bg py-16 px-4 md:py-24">
    <div class="max-w-6xl mx-auto text-left">
      <span class="text-light-accent font-bold tracking-wider uppercase text-sm mb-4 block drop-shadow-sm">Since 2005 • Katy, TX</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-light-text mb-6 leading-tight">
        Houston's Premier <br class="hidden md:block" />
        <span class="text-light-accent">Auto Upholstery</span> Experts.
      </h1>
      <p class="text-lg md:text-xl text-light-muted mb-10 max-w-2xl leading-relaxed">
        From custom leather seat installations to full classic car interior restorations, our master craftsmen bring over 20 years of precision and care to every vehicle we touch.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-start">
        <a href="#contact" class="px-8 py-4 bg-light-accent hover:brightness-110 active:scale-95 text-white text-base font-semibold transition-all shadow-lg shadow-light-accent/30 rounded-sm">
          Get a Free Estimate
        </a>
        <a href="#services" class="px-8 py-4 bg-white hover:bg-gray-50 active:scale-95 border-2 border-light-accent text-light-accent text-base font-bold transition-all shadow-sm rounded-sm">
          Explore Our Services
        </a>
      </div>
    </div>
  </div>
</section>
